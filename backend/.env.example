APP_ENV=local
APP_NAME=B-Snap API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bsnap
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
UPLOAD_DIR=backend/uploads
UPLOAD_MAX_BYTES=31457280
AI_IMAGE_MAX_BYTES=29360128
DOCLING_BATCH_SIZE=20
DOCLING_FALLBACK_BATCH_SIZES=10,5
VISION_CONCURRENCY=3
RAG_TEXT_MIN_SCORE=0.45
RAG_IMAGE_SUMMARY_MIN_SCORE=0.50
RAG_IMAGE_RECHECK_MIN_SCORE=0.55
RAG_INTERNAL_TOP_K=12
RAG_CONTEXT_MAX_CHUNKS=5
RAG_SOURCE_DISPLAY_MAX=4
RAG_IMAGE_SEARCH_TOP_K=5
RAG_IMAGE_RECHECK_ENABLED=true
RAG_IMAGE_RECHECK_JUDGE_TOP_K=3
RAG_IMAGE_RECHECK_MAX_IMAGES=2
PAGE_MAX_IMAGE_CROPS=3
DOCUMENT_MAX_VISION_JOBS=60
JWT_SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=10080
