EXPO_PUBLIC_BACKEND_URL=http://192.168.x.x:8000

# Production/demo default: debug UI hidden, automatic backend handwriting analysis enabled.
EXPO_PUBLIC_ENABLE_HANDWRITING_DEBUG=false
# Production/demo default: hide transient workspace toast messages; save status badge remains visible.
EXPO_PUBLIC_ENABLE_WORKSPACE_FEEDBACK_TOASTS=false
# Set to false only when you need to disable automatic geometry/Vision analysis after page saves.
EXPO_PUBLIC_ENABLE_HANDWRITING_AUTO_ANALYZE=true
# Set to false to force geometry-only automatic analysis. Backend guardrails still control real Vision calls.
EXPO_PUBLIC_ENABLE_HANDWRITING_AUTO_VISION=true
